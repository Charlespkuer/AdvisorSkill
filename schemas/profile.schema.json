{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authorization"
    },
    "discipline": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Discipline"
    },
    "display_name": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Display Name",
      "type": "string"
    },
    "language": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "license": {
      "anyOf": [
        {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "License"
    },
    "profile_id": {
      "maxLength": 56,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "title": "Profile Id",
      "type": "string"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "rules_path": {
      "const": "state.json#/rules",
      "default": "state.json#/rules",
      "title": "Rules Path",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "version": {
      "default": "0.1.0",
      "minLength": 1,
      "pattern": "\\S",
      "title": "Version",
      "type": "string"
    },
    "visibility": {
      "const": "private",
      "default": "private",
      "title": "Visibility",
      "type": "string"
    }
  },
  "required": [
    "profile_id",
    "display_name"
  ],
  "title": "Profile",
  "type": "object"
}
